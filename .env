# =========================
# Audio
# =========================

SAMPLE_RATE=16000
CHANNELS=1
CHUNK_MS=100


# =========================
# Whisper
# =========================

WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# 한국어/영어/일본어/중국어 자동 감지
WHISPER_LANGUAGE=auto


# =========================
# VAD
# =========================

VAD_THRESHOLD=0.5
MIN_SPEECH_MS=250
MIN_SILENCE_MS=500


# =========================
# Translation
# =========================

TRANSLATION_PROVIDER=deepl

DEEPL_API_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini


# =========================
# Language
# =========================

TARGET_LANGUAGE=JA


# =========================
# Server
# =========================

WS_HOST=localhost
WS_PORT=8765

CAPTION_FILE=stream_caption.txt